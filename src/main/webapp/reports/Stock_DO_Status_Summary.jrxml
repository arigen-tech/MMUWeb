	</parameter>
	<parameter name="DISTRICT_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="query" class="java.lang.String">
		<defaultValueExpression><![CDATA[new String("")]]></defaultValueExpression>
	</parameter>
	<parameter name="CurrentDate" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select DISTRICT_NAME HOSPITAL_NAME , MAS_DEPARTMENT.DEPARTMENT_NAME, mas_store_item.pvms_no as mas_store_item_pvms_no,mas_store_item.nomenclature as mas_store_item_nomenclature,
MAS_STORE_UNIT.STORE_UNIT_NAME ,sum(store_item_batch_stock.CLOSING_STOCK) as balance_qty,
DISTRICT_NAME
 from mas_store_item mas_store_item
inner join store_item_batch_stock store_item_batch_stock on mas_store_item.item_id = store_item_batch_stock.item_id
inner join MAS_DISTRICT on STORE_ITEM_BATCH_STOCK.DISTRICT_ID=MAS_DISTRICT.DISTRICT_ID
LEFT OUTER JOIN MAS_STORE_UNIT on MAS_STORE_ITEM.ITEM_UNIT_ID=MAS_STORE_UNIT.STORE_UNIT_ID
LEFT OUTER JOIN MAS_DEPARTMENT on STORE_ITEM_BATCH_STOCK.DEPARTMENT_ID=MAS_DEPARTMENT.DEPARTMENT_ID
LEFT OUTER JOIN mas_store_supplier_type SST on STORE_ITEM_BATCH_STOCK.supplier_type_id=sst.supplier_type_id
LEFT OUTER JOIN mas_store_supplier mss on STORE_ITEM_BATCH_STOCK.supplier_id=mss.supplier_id
where  (store_item_batch_stock.DISTRICT_ID=$P{DISTRICT_ID}OR $P{DISTRICT_ID}=0)AND
store_item_batch_stock.expiry_date > current_date
$P!{query}
group by mas_store_item.pvms_no,mas_store_item.nomenclature , MAS_STORE_UNIT.STORE_UNIT_NAME,DISTRICT_NAME , MAS_DEPARTMENT.DEPARTMENT_NAME,supplier_name,supplier_type_name
order by  DISTRICT_NAME ,mas_store_item.nomenclature]]>
	</queryString>
