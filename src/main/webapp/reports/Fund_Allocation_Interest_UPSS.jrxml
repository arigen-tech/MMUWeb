	</parameter>
	<parameter name="From_Date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="To_Date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="district_id" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="p_fundtype" class="java.lang.String">
		<defaultValueExpression><![CDATA[new String(" ")]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT  AKS.UPSS UPSS,
			AKS.UPSS_ID UPSS_ID,
			AKS.financial_year,
			AKS.Interest Interest_Amt,
			AKS.user_name approved_by,
			AKS.approved_date,
			AKS.created_on,
			AKS.file_name
	FROM
	(SELECT MD.district_id UPSS_ID,
				MD.UPSS,
				cik.financial_year,
				cid.interest,
				TO_CHAR(cid.approved_date,'dd/mm/yyyy') approved_date,
				TO_CHAR(cik.created_on,'dd/mm/yyyy') created_on,
				US.user_name,
				cid.file_name
	from 	    capture_interest_hd cik left outer JOIN capture_interest_dt cid ON cid.capture_interest_hd_id=cik.capture_interest_hd_id
	 							        left outer JOIN MAS_district MD ON MD.district_id=cid.district_id
										left outer join users US on US.user_id=cid.created_by
	WHERE   cik.created_on  ::date between $P{From_Date} AND $P{To_Date}  and head_type_id=4 AND cik.status ='A'  AND $P{p_fundtype}='I'
	and (cid.district_id =  $P{district_id})) AKS;]]>
	</queryString>
